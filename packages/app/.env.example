# Copy to .env.local (not committed). See docs/DEVELOPMENT.md.

# Team folder in Dropbox: the App key of Sweet Flow's Dropbox app (PKCE, no secret).
VITE_DROPBOX_APP_KEY=

# Team folder in Google Drive: the OAuth client of Sweet Flow (web application).
VITE_GOOGLE_CLIENT_ID=
# Only the dev server reads this (no VITE_ prefix): it never reaches the page.
GOOGLE_CLIENT_SECRET=
