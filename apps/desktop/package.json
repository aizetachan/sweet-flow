{
  "name": "@sweetflow/desktop",
  "productName": "Sweet Flow",
  "version": "0.0.0",
  "private": true,
  "description": "Sweet Flow — escritorio (macOS + Windows)",
  "author": "Sweet Flow",
  "main": "out/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@sweetflow/app": "workspace:*",
    "@types/node": "^22.20.5",
    "electron": "^43.7.11",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3"
  }
}
