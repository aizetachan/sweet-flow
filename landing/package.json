{
  "name": "sweetflow-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Sweet Flow — landing page (Firebase Hosting + Functions). Independent of the monorepo.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && pnpm --filter sweetflow-landing-functions typecheck",
    "test": "pnpm --filter sweetflow-landing-functions test",
    "build:functions": "pnpm --filter sweetflow-landing-functions build",
    "emulators": "pnpm build:functions && firebase emulators:start --only functions,firestore",
    "deploy": "pnpm build && firebase deploy",
    "deploy:hosting": "pnpm build && firebase deploy --only hosting"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  }
}
