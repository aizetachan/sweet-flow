# Copy to `functions/.env` (ignored by git). Non-secret parameters read by
# firebase-functions/params. The SMTP password is a secret:
#   firebase functions:secrets:set SMTP_PASS

# Where "Habla con nosotros" messages are delivered.
CONTACT_TO=tu@correo.com
# Sender shown in the inbox. With Gmail SMTP it must be the same account.
CONTACT_FROM="Sweet Flow <tu@correo.com>"

# SMTP server. Gmail: smtp.gmail.com, port 465, user = your address,
# password = an app password (Google account › Security › App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu@correo.com
