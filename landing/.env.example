# Copy to `.env` (ignored by git). Values from the Firebase console:
# Project settings › General › Your apps › Web app › SDK setup and configuration.
# They are public identifiers, not secrets: the Firestore rules are the security.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sweetflow-landing.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sweetflow-landing
VITE_FIREBASE_APP_ID=
